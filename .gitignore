# ============================================================
#  .gitignore для Unity-проекта
#  Положите этот файл в КОРЕНЬ проекта — рядом с папками
#  Assets, Packages и ProjectSettings.
# ============================================================

# --- Папки, которые Unity генерирует автоматически ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Папки сборок, если вы кладёте их в другое место
/[Bb]uild*/
/[Oo]ut/

# Asset Store Tools (если используете)
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Кэш и временные файлы Addressables / Burst
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# Gradle (Android)
.gradle/

# --- Файлы IDE и редакторов кода ---
# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.sln.DotSettings.user

# --- Отладочные и crash-файлы ---
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# --- Собранные приложения ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dmg
*.ipa

# --- Системные файлы ОС ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
